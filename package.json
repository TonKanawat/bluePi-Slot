{
  "name": "bluepi-slot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "_comment_build_check": "A plain build with no Supabase env vars is misleading: supabase is statically null, so Rollup drops everything after the not-connected branch and the bundle is ~146kB of React with no app in it. Dummy values keep the whole app in the graph.",
    "build:check": "tsc -b && VITE_SUPABASE_URL=https://example.supabase.co VITE_SUPABASE_ANON_KEY=build-check vite build --outDir /tmp/bluepi-buildcheck --emptyOutDir",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
